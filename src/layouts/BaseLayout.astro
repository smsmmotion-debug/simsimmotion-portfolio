---
import '@fontsource-variable/archivo';
import '@fontsource/bodoni-moda/latin-400.css';
import '@fontsource/bodoni-moda/latin-400-italic.css';
import '@fontsource/caveat/latin-500.css';
import '../styles/global.css';

import { siteConfig } from '../config';
import { withBase } from '../lib/paths';
import Cursor from '../components/Cursor.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title?: string;
  description?: string;
  page?: 'home' | 'works' | 'info' | 'contact';
  footer?: boolean;
  image?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = siteConfig.description,
  page,
  footer = true,
  image = '/og.jpg',
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} — ${siteConfig.brand.full}` : siteConfig.title;
const origin = Astro.site ?? new URL('https://simsimmotion.github.io');
const canonical = new URL(Astro.url.pathname, origin);
const ogImage = new URL(withBase(image), origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#E9E4DC" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.brand.full} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${siteConfig.brand.full} — ${siteConfig.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body id="top" class:list={[page && `page-${page}`]}>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader />
    <SiteNav page={page} />

    <slot />

    {footer && <SiteFooter />}

    <Cursor />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Gentle reveal for editorial sections. Content is visible without JS.
      const revealItems = document.querySelectorAll<HTMLElement>('.reveal');

      if (!reduceMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );

        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }

      // Hero videos are marked instead of using the autoplay attribute so
      // reduced-motion preferences can leave the poster frame in place.
      if (!reduceMotion) {
        document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((video) => {
          video.play().catch(() => {});
        });
      }
    </script>
  </body>
</html>
