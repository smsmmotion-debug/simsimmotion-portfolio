---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config';
import { projects } from '../../data/projects';
import { withBase } from '../../lib/paths';

const count = String(projects.length).padStart(2, '0');
const categoryLine = 'Real Estate · Basketball';
---

<BaseLayout
  page="works"
  title="Works"
  description={`Selected real estate and basketball edits by ${siteConfig.brand.full}.`}
>
  <main id="main" class="works-page">
    <header class="works-hero wrap">
      <div class="works-hero__meta page-head">
        <p class="eyebrow">Selected work</p>
        <p class="eyebrow eyebrow--muted">{categoryLine} · {count} projects</p>
      </div>

      <div class="works-hero__body">
        <h1 class="works-hero__title serif">
          A selection of<br /><em>moving</em> images.
        </h1>
        <p class="works-hero__note">
          Real estate and basketball edits — cut fast, clean and cinematic.
        </p>
      </div>
    </header>

    <section class="works-index" id="index" aria-labelledby="works-index-title">
      <h2 id="works-index-title" class="sr-only">Project index</h2>

      <div class="works-index__head wrap" aria-hidden="true">
        <span>No.</span>
        <span>Project</span>
        <span>Category</span>
      </div>

      <ul class="works-list wrap">
        {
          projects.map((project, index) => (
            <li
              class="works-row reveal"
              data-video={withBase(project.video)}
              data-poster={withBase(project.poster)}
              data-title={project.title}
              data-meta={project.category}
              style={`--reveal-delay: ${index * 65}ms`}
            >
              <a
                class="works-row__link"
                href={withBase(`/works/${project.slug}/`)}
                data-cursor="VIEW"
              >
                <span class="works-row__number">{project.number}</span>
                <span class="works-row__title">{project.title}</span>
                <span class="works-row__category">{project.category}</span>

                <span class="works-row__thumb" aria-hidden="true">
                  <img
                    src={withBase(project.poster)}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="works-cta wrap" aria-labelledby="works-contact-title">
      <p class="eyebrow">Contact</p>
      <div class="works-cta__row">
        <h2 id="works-contact-title" class="works-cta__title serif">
          Work<br />with me.
        </h2>
        <div class="works-cta__links">
          <a
            class="works-cta__link"
            href={`mailto:${siteConfig.email}`}
            data-cursor="WRITE"
          >
            Email
            <span aria-hidden="true">↗</span>
          </a>
          {
            siteConfig.socials.map((social) => (
              <a
                class="works-cta__link"
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                data-cursor="OPEN"
              >
                {social.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <div class="works-preview" data-preview aria-hidden="true">
    <div class="works-preview__frame">
      <video data-preview-video muted loop playsinline preload="none"></video>
      <span class="works-preview__label">Preview</span>
    </div>
    <div class="works-preview__caption">
      <span data-preview-title></span>
      <span data-preview-meta></span>
    </div>
  </div>
</BaseLayout>

<style>
  .works-page {
    padding-top: calc(var(--header-h) + clamp(1.5rem, 4vh, 3.5rem));
  }

  .works-hero {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .works-hero__meta {
    border-bottom: 1px solid var(--line);
  }

  .works-hero__body {
    display: grid;
    grid-template-columns: minmax(0, 2.1fr) minmax(16rem, 0.9fr);
    align-items: end;
    gap: var(--gap);
    margin-top: clamp(2.6rem, 7vw, 6rem);
  }

  .works-hero__title {
    max-width: 16ch;
    font-size: clamp(3.1rem, 7.6vw, 9.3rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
  }

  .works-hero__title em {
    color: var(--lilac-deep);
    font-style: italic;
  }

  .works-hero__note {
    max-width: 28ch;
    justify-self: end;
    padding-bottom: 0.45rem;
    color: var(--muted);
    font-size: clamp(0.75rem, 0.9vw, 0.85rem);
    line-height: 1.6;
  }

  .works-index {
    border-top: 1px solid var(--line);
  }

  .works-index__head,
  .works-row__link {
    display: grid;
    grid-template-columns: 3.1rem minmax(0, 2.65fr) minmax(0, 1.15fr);
    gap: var(--gap);
    align-items: center;
  }

  .works-index__head {
    padding-top: 0.72rem;
    padding-bottom: 0.72rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .works-index__head span:last-child {
    text-align: right;
  }

  .works-row {
    border-bottom: 1px solid var(--line);
    opacity: 1;
    transition:
      opacity 0.35s linear,
      transform 0.35s var(--ease);
  }

  .works-row__link {
    position: relative;
    padding: clamp(1.2rem, 1.9vw, 1.7rem) 0;
  }

  .works-row__link::before {
    content: '';
    position: absolute;
    top: 0;
    right: calc(var(--pad) * -0.35);
    bottom: 0;
    left: calc(var(--pad) * -0.35);
    z-index: -1;
    background: rgba(247, 243, 235, 0.36);
    opacity: 0;
    transition: opacity 0.3s linear;
  }

  .works-row:hover .works-row__link::before {
    opacity: 1;
  }

  .works-row__number {
    color: var(--muted);
    font-size: 0.5625rem;
    letter-spacing: 0.15em;
  }

  .works-row__title {
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 2.1vw, 2.15rem);
    line-height: 1;
    letter-spacing: -0.015em;
    transition:
      transform 0.5s var(--ease),
      color 0.3s linear,
      font-style 0.3s linear;
  }

  .works-row__category {
    color: var(--muted);
    font-size: 0.5625rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.16em;
    text-align: right;
    text-transform: uppercase;
  }

  .works-row:hover .works-row__title,
  .works-row:focus-within .works-row__title {
    color: var(--lilac-deep);
    font-style: italic;
    transform: translateX(0.45rem);
  }

  .works-row__thumb {
    display: none;
  }

  .works-row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Floating preview */
  .works-preview {
    position: fixed;
    top: 50%;
    right: 3.2vw;
    z-index: 900;
    width: clamp(15rem, 27vw, 26rem);
    pointer-events: none;
    opacity: 0;
    transform: translateY(-46%) scale(0.97);
    transition:
      opacity 0.35s var(--ease),
      transform 0.5s var(--ease);
  }

  .works-preview.is-visible {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  .works-preview__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--ink);
    box-shadow: 0 24px 70px rgba(20, 19, 17, 0.18);
  }

  .works-preview__frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
  }

  .works-preview__label {
    position: absolute;
    top: 0.6rem;
    right: 0.65rem;
    padding: 0.32rem 0.42rem;
    background: rgba(20, 19, 17, 0.72);
    color: var(--paper);
    font-size: 0.45rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
  }

  .works-preview__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.6rem;
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .works-preview__caption span:last-child {
    color: var(--muted);
    text-align: right;
  }

  .works-cta {
    padding-top: clamp(5rem, 12vw, 11rem);
    padding-bottom: clamp(5rem, 11vw, 10rem);
  }

  .works-cta__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--line);
  }

  .works-cta__title {
    font-size: clamp(2.4rem, 5.2vw, 5.6rem);
    line-height: 0.94;
    letter-spacing: -0.035em;
  }

  .works-cta__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .works-cta__link {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.3s linear;
  }

  .works-cta__link span {
    font-size: 0.9rem;
    transition: transform 0.35s var(--ease);
  }

  .works-cta__link:hover {
    color: var(--lilac-deep);
  }

  .works-cta__link:hover span {
    transform: translate(2px, -2px);
  }

  @media (max-width: 1000px) {
    .works-preview {
      display: none;
    }

    .works-index__head,
    .works-row__link {
      grid-template-columns: 2.4rem minmax(0, 2.5fr) minmax(0, 1.2fr) 4.6rem;
    }

    .works-row__link {
      grid-template-rows: auto;
      row-gap: 0;
    }

    .works-row__thumb {
      display: block;
      grid-column: 4;
      grid-row: 1;
      width: 4.6rem;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      justify-self: end;
    }
  }

  @media (max-width: 760px) {
    .works-hero__body {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-items: start;
    }

    .works-hero__title {
      max-width: 12ch;
    }

    .works-hero__note {
      max-width: 34ch;
      justify-self: start;
      padding-bottom: 0;
    }

    .works-index__head {
      display: none;
    }

    .works-index {
      border-top: 0;
    }

    .works-row__link {
      grid-template-columns: 1.6rem minmax(0, 1fr) 5.1rem;
      grid-template-rows: auto auto;
      column-gap: 0.9rem;
      row-gap: 0.5rem;
      padding: 1.1rem 0;
    }

    .works-row__number {
      grid-column: 1;
      grid-row: 1;
    }

    .works-row__title {
      grid-column: 2;
      grid-row: 1;
      font-size: 1.55rem;
    }

    .works-row__thumb {
      grid-column: 3;
      grid-row: 1 / 3;
      width: 100%;
      align-self: center;
    }

    .works-row__category {
      grid-column: 2;
      grid-row: 2;
      font-size: 0.48rem;
      text-align: left;
    }

    .works-row:hover .works-row__title {
      transform: none;
    }

    .works-cta__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2.2rem;
    }
  }
</style>

<script>
  const preview = document.querySelector<HTMLElement>('[data-preview]');
  const previewVideo = document.querySelector<HTMLVideoElement>('[data-preview-video]');
  const previewTitle = document.querySelector<HTMLElement>('[data-preview-title]');
  const previewMeta = document.querySelector<HTMLElement>('[data-preview-meta]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.works-row'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let hideTimer: number | undefined;

  const showPreview = (row: HTMLElement) => {
    if (!preview || !previewVideo) return;
    window.clearTimeout(hideTimer);

    const video = row.dataset.video;
    const poster = row.dataset.poster;

    if (video) {
      previewVideo.poster = poster ?? '';
      if (previewVideo.dataset.src !== video) {
        previewVideo.dataset.src = video;
        previewVideo.src = video;
        previewVideo.load();
      }
      if (!reduceMotion) {
        previewVideo.play().catch(() => {});
      }
    }

    if (previewTitle) previewTitle.textContent = row.dataset.title ?? '';
    if (previewMeta) previewMeta.textContent = row.dataset.meta ?? '';
    preview.classList.add('is-visible');
    preview.setAttribute('aria-hidden', 'false');
  };

  const hidePreview = () => {
    if (!preview) return;
    hideTimer = window.setTimeout(() => {
      preview.classList.remove('is-visible');
      preview.setAttribute('aria-hidden', 'true');
      previewVideo?.pause();
    }, 90);
  };

  rows.forEach((row) => {
    row.addEventListener('pointerenter', () => showPreview(row));
    row.addEventListener('pointerleave', hidePreview);
    row.addEventListener('focusin', () => showPreview(row));
    row.addEventListener('focusout', hidePreview);
  });

  document.querySelector('.works-list')?.addEventListener('pointerleave', hidePreview);
</script>
