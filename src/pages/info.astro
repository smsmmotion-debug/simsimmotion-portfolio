---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
import { projects } from '../data/projects';
import { withBase } from '../lib/paths';

const services = [
  {
    number: '01',
    title: 'Video editing',
    copy: 'Fast, clean and cinematic edits, built around rhythm and motion.',
  },
  {
    number: '02',
    title: 'AI visuals',
    copy: 'Traditional editing mixed with AI-generated visuals.',
  },
  {
    number: '03',
    title: 'Real estate & sports',
    copy: 'Content for real estate and sports, from raw footage to final cut.',
  },
];
---

<BaseLayout
  page="info"
  title="Info"
  description={`About ${siteConfig.brand.full} — video editor and AI creator working across real estate and sports content.`}
>
  <main id="main" class="info-page">
    <header class="info-hero wrap">
      <div class="info-hero__meta page-head">
        <p class="eyebrow">Info</p>
        <p class="eyebrow eyebrow--muted">Real estate · Basketball</p>
      </div>

      <div class="info-hero__body">
        <h1 class="info-hero__title serif">
          Video editor<br />&amp; <em>AI creator.</em>
        </h1>
        <p class="info-hero__note">
          I turn raw footage into content that moves.
        </p>
      </div>
    </header>

    <section class="info-story wrap" aria-labelledby="story-title">
      <h2 id="story-title" class="sr-only">About SimSimMotion</h2>

      <figure class="info-story__figure reveal">
        <div class="info-story__frame">
          <img
            src={withBase('/media/stills/simsim-portrait.jpg')}
            alt="Portrait of SimSimMotion wearing sunglasses."
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>
          <span>SimSimMotion — portrait</span>
          <span>01</span>
        </figcaption>
        <span class="info-story__script" aria-hidden="true">{siteConfig.tagline}</span>
      </figure>

      <div class="info-story__copy">
        <p class="info-story__lead serif reveal">
          Rhythm, motion and visual storytelling.
        </p>

        <div class="info-story__text reveal">
          <p>
            I'm a video editor and AI creator obsessed with rhythm, motion and visual
            storytelling. I work across real estate and sports content, cutting fast,
            clean and cinematic edits, and I'm always pushing new ways to mix traditional
            editing with AI-generated visuals.
          </p>
        </div>

        <div class="info-story__foot reveal">
          <a class="info-story__link" href={withBase('/contact/')} data-cursor="OPEN">
            Work with me <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="info-services" aria-labelledby="services-title">
      <div class="wrap">
        <div class="page-head info-services__head">
          <p class="eyebrow">01 — Capabilities</p>
          <p class="eyebrow eyebrow--muted">What I do</p>
        </div>

        <h2 id="services-title" class="sr-only">Capabilities</h2>

        <ul class="service-list">
          {
            services.map((service) => (
              <li class="service reveal">
                <span class="service__number">{service.number}</span>
                <h3 class="service__title serif">{service.title}</h3>
                <p class="service__copy">{service.copy}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="info-wide" aria-label="Project still">
      <div class="info-wide__frame reveal">
        <img
          src={withBase('/media/posters/fiba-vol-01.jpg')}
          alt="Close-up of basketball players’ feet on a court in black and white."
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="info-wide__caption wrap">
        <span>FIBA Vol. 1 — still</span>
        <span>Basketball edit</span>
      </div>
    </section>

    <section class="info-collaborators wrap" aria-labelledby="collaborators-title">
      <div class="page-head">
        <p class="eyebrow">02 — Selected work</p>
        <p class="eyebrow eyebrow--muted">Real estate · Basketball</p>
      </div>

      <h2 id="collaborators-title" class="sr-only">Selected work</h2>

      <ul class="collaborators">
        {
          projects.map((project, index) => (
            <li class="reveal" style={`--reveal-delay: ${index * 45}ms`}>
              <span class="collaborators__index">{project.number}</span>
              <a
                class="collaborators__name serif"
                href={withBase(`/works/${project.slug}/`)}
                data-cursor="VIEW"
              >
                {project.title}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="collaborators__note">
        Five edits across real estate and basketball.{' '}
        <a class="link-line" href={withBase('/works/')}>See all works</a>.
      </p>
    </section>

    <section class="info-quote wrap" aria-labelledby="approach-title">
      <div class="page-head">
        <p class="eyebrow">03 — Approach</p>
        <p class="eyebrow eyebrow--muted">The process</p>
      </div>

      <div class="info-quote__body">
        <h2 id="approach-title" class="info-quote__title serif reveal">
          Edit. Create.<br /><em>Repeat.</em>
        </h2>
        <p class="info-quote__note reveal">
          Video editor &amp; AI creator. I turn raw footage into content that moves.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .info-page {
    padding-top: calc(var(--header-h) + clamp(1.5rem, 4vh, 3.5rem));
  }

  .info-hero {
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }

  .info-hero__body {
    display: grid;
    grid-template-columns: minmax(0, 2.15fr) minmax(16rem, 0.85fr);
    align-items: end;
    gap: var(--gap);
    margin-top: clamp(2.5rem, 7vw, 6rem);
  }

  .info-hero__title {
    max-width: 11ch;
    font-size: clamp(3.1rem, 7.4vw, 9rem);
    line-height: 0.89;
    letter-spacing: -0.045em;
  }

  .info-hero__title em {
    color: var(--lilac-deep);
    font-style: italic;
  }

  .info-hero__note {
    max-width: 32ch;
    justify-self: end;
    padding-bottom: 0.4rem;
    color: var(--muted);
    font-size: clamp(0.78rem, 0.95vw, 0.9rem);
    line-height: 1.65;
  }

  .info-story {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    align-items: start;
    padding-top: clamp(3rem, 8vw, 7rem);
    padding-bottom: clamp(5rem, 11vw, 10rem);
    border-top: 1px solid var(--line);
  }

  .info-story__figure {
    position: relative;
    grid-column: 1 / 6;
    margin: 0;
  }

  .info-story__frame {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--bone-deep);
  }

  .info-story__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 34%;
    filter: grayscale(1) contrast(1.03);
  }

  .info-story__figure figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.7rem;
    color: var(--muted);
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .info-story__script {
    position: absolute;
    right: -2.2rem;
    bottom: 3.5rem;
    color: var(--lilac-deep);
    font-family: var(--font-script);
    font-size: clamp(1.6rem, 2.6vw, 2.6rem);
    line-height: 1;
    transform: rotate(-5deg);
    transform-origin: center;
  }

  .info-story__copy {
    display: flex;
    grid-column: 7 / 12;
    flex-direction: column;
    gap: clamp(1.6rem, 3vw, 2.8rem);
    padding-top: clamp(0rem, 4vw, 3rem);
  }

  .info-story__lead {
    max-width: 17ch;
    font-size: clamp(2rem, 3.5vw, 3.9rem);
    line-height: 1.07;
    letter-spacing: -0.035em;
  }

  .info-story__text {
    display: flex;
    max-width: 46ch;
    flex-direction: column;
    gap: 1rem;
    color: var(--muted);
    font-size: clamp(0.8rem, 0.92vw, 0.9rem);
    line-height: 1.7;
  }

  .info-story__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .info-story__availability {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .info-story__availability span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--lilac-deep);
  }

  .info-story__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.3s linear;
  }

  .info-story__link span {
    font-size: 0.85rem;
    transition: transform 0.35s var(--ease);
  }

  .info-story__link:hover {
    color: var(--lilac-deep);
  }

  .info-story__link:hover span {
    transform: translate(2px, -2px);
  }

  .info-services {
    padding-top: clamp(4rem, 9vw, 8rem);
    padding-bottom: clamp(4rem, 9vw, 8rem);
    background: var(--bone-deep);
  }

  .info-services__head {
    border-color: rgba(20, 19, 17, 0.2);
  }

  .service-list {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .service {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1.05fr) minmax(0, 1.2fr);
    gap: var(--gap);
    align-items: start;
    padding: clamp(1.2rem, 2.2vw, 1.8rem) 0;
    border-top: 1px solid rgba(20, 19, 17, 0.18);
  }

  .service:last-child {
    border-bottom: 1px solid rgba(20, 19, 17, 0.18);
  }

  .service__number {
    color: var(--muted);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
  }

  .service__title {
    font-size: clamp(1.5rem, 2.4vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .service__copy {
    max-width: 42ch;
    color: var(--muted);
    font-size: clamp(0.78rem, 0.9vw, 0.88rem);
    line-height: 1.65;
  }

  .info-wide {
    padding-top: clamp(4rem, 9vw, 8rem);
  }

  .info-wide__frame {
    overflow: hidden;
    aspect-ratio: 21 / 9;
    min-height: 18rem;
    background: var(--bone-deep);
  }

  .info-wide__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35) saturate(0.7);
    transform: scale(1.01);
    transition: transform 1.4s var(--ease);
  }

  .info-wide__frame:hover img {
    transform: scale(1.045);
  }

  .info-wide__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.7rem;
    color: var(--muted);
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .info-collaborators {
    padding-top: clamp(5rem, 11vw, 10rem);
    padding-bottom: clamp(5rem, 11vw, 10rem);
  }

  .collaborators {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--line);
  }

  .collaborators li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--gap);
    align-items: baseline;
    padding: clamp(0.9rem, 1.7vw, 1.35rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .collaborators__index {
    color: var(--muted);
    font-size: 0.5rem;
    letter-spacing: 0.14em;
  }

  .collaborators__name {
    font-size: clamp(1.6rem, 3vw, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .collaborators__note {
    max-width: 42ch;
    margin-top: 1.4rem;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .info-quote {
    padding-top: clamp(4rem, 9vw, 8rem);
    padding-bottom: clamp(5rem, 12vw, 11rem);
  }

  .info-quote__body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(14rem, 0.65fr);
    align-items: end;
    gap: var(--gap);
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .info-quote__title {
    font-size: clamp(2.8rem, 6.4vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .info-quote__title em {
    color: var(--lilac-deep);
    font-style: italic;
  }

  .info-quote__note {
    max-width: 26ch;
    justify-self: end;
    padding-bottom: 0.5rem;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .info-hero__body {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.5rem;
    }

    .info-hero__note {
      max-width: 38ch;
      justify-self: start;
      padding-bottom: 0;
    }

    .info-story__figure {
      grid-column: 1 / 7;
    }

    .info-story__copy {
      grid-column: 7 / 13;
      padding-top: 0;
    }

    .info-story__script {
      right: auto;
      left: 0;
      bottom: 3rem;
      padding-left: 1rem;
    }

    .service {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }

    .service__copy {
      grid-column: 2;
      margin-top: 0.5rem;
    }

    .info-wide__frame {
      aspect-ratio: 16 / 9;
    }

    .info-quote__body {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .info-quote__note {
      max-width: 34ch;
      justify-self: start;
    }
  }

  @media (max-width: 760px) {
    .info-hero__title {
      max-width: 12ch;
    }

    .info-story {
      grid-template-columns: 1fr;
    }

    .info-story__figure,
    .info-story__copy {
      grid-column: 1;
    }

    .info-story__figure {
      max-width: 80%;
    }

    .info-story__script {
      right: 0.5rem;
      bottom: 3rem;
      left: auto;
      padding-left: 0;
    }

    .info-story__foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .info-services {
      padding-right: 0;
      padding-left: 0;
    }

    .info-services .wrap {
      padding-inline: var(--pad);
    }

    .service {
      grid-template-columns: 2rem 1fr;
    }

    .info-wide__frame {
      aspect-ratio: 4 / 3;
      min-height: 0;
    }

    .info-wide__caption {
      flex-direction: column;
      gap: 0.35rem;
    }

    .collaborators li {
      grid-template-columns: 2rem 1fr;
    }
  }
</style>
