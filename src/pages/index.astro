---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
import { projects } from '../data/projects';
import { withBase } from '../lib/paths';
---

<BaseLayout page="home" footer={false}>
  <main id="main">
    <section class="home" data-home data-paused="false" aria-label="Featured projects">
      <h1 class="sr-only">{siteConfig.brand.full} — selected projects</h1>

      <div class="home__slides">
        {
          projects.map((project, index) => (
            <article
              class:list={['home-slide', index === 0 && 'is-active']}
              data-slide
              data-index={index}
              aria-hidden={index === 0 ? 'false' : 'true'}
              inert={index !== 0}
            >
              <a
                class="home-slide__link"
                href={withBase(`/works/${project.slug}/`)}
                aria-label={`${project.title} — ${project.category}. View project.`}
                data-cursor="VIEW"
              >
                <div class="home-slide__media">
                  <video
                    poster={withBase(project.poster)}
                    preload={index === 0 ? 'auto' : 'metadata'}
                    muted
                    loop
                    playsinline
                    tabindex="-1"
                  >
                    <source src={withBase(project.video)} type="video/mp4" />
                  </video>
                </div>

                <div class="home-slide__shade" aria-hidden="true" />

                <div class="home-slide__meta">
                  <div class="home-slide__left">
                    <span class="home-slide__number">{project.number}</span>
                    {project.client && <span>{project.client}</span>}
                  </div>

                  <h2 class="home-slide__title">{project.title}</h2>

                  <div class="home-slide__right">
                    <span>{project.category}</span>
                    {project.year && <span>{project.year}</span>}
                  </div>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <div class="home-progress" role="group" aria-label="Project slideshow">
        <div class="home-progress__meta">
          <span class="home-progress__count" data-counter>
            01 / {String(projects.length).padStart(2, '0')}
          </span>
          <button
            class="home-progress__toggle"
            type="button"
            data-toggle
            aria-label="Pause slideshow"
            aria-pressed="false"
          >
            <span class="pause-icon" aria-hidden="true"><i></i><i></i></span>
            <span class="play-icon" aria-hidden="true">▶</span>
          </button>
        </div>

        <div class="home-progress__bars">
          {
            projects.map((project, index) => (
              <button
                class:list={['home-progress__bar', index === 0 && 'is-active']}
                type="button"
                data-progress={index}
                aria-label={`Go to ${project.title}`}
                aria-current={index === 0 ? 'true' : 'false'}
              >
                <span aria-hidden="true" />
              </button>
            ))
          }
        </div>
      </div>

      {
        siteConfig.availability && (
          <p class="home-availability">
            <span class="home-availability__dot" aria-hidden="true"></span>
            {siteConfig.availability}
          </p>
        )
      }
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    position: relative;
    height: 100svh;
    min-height: 620px;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
  }

  .home__slides {
    position: absolute;
    inset: 0;
  }

  .home-slide {
    position: absolute;
    inset: 0;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 1.1s var(--ease),
      visibility 1.1s linear;
  }

  .home-slide.is-active {
    z-index: 1;
    visibility: visible;
    opacity: 1;
  }

  .home-slide__link {
    position: absolute;
    inset: 0;
    display: block;
  }

  .home-slide__link:focus-visible {
    outline: 1px solid var(--paper);
    outline-offset: -8px;
  }

  .home-slide__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--ink);
  }

  .home-slide__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.82) contrast(1.03);
    transform: scale(1.055);
    transition: transform 7.4s linear;
  }

  .home-slide.is-active .home-slide__media video {
    transform: scale(1.004);
  }

  .home-slide__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(9, 8, 7, 0.5) 0%,
        rgba(9, 8, 7, 0.03) 26%,
        rgba(9, 8, 7, 0.05) 54%,
        rgba(9, 8, 7, 0.68) 100%
      ),
      radial-gradient(ellipse at center, transparent 34%, rgba(9, 8, 7, 0.34) 100%);
  }

  .home-slide__meta {
    position: absolute;
    top: 50%;
    right: var(--pad);
    left: var(--pad);
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(120px, 1fr) minmax(0, 2.7fr) minmax(120px, 1fr);
    align-items: center;
    gap: clamp(1rem, 4vw, 4.5rem);
    transform: translateY(-50%);
  }

  .home-slide__left,
  .home-slide__right {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.5625rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.35);
  }

  .home-slide__right {
    align-items: flex-end;
    text-align: right;
  }

  .home-slide__number {
    color: var(--lilac);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
  }

  .home-slide__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 6.5vw, 7.2rem);
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25);
  }

  .home-slide.is-active .home-slide__title {
    animation: home-title 1.15s var(--ease) both;
  }

  .home-slide.is-active .home-slide__left,
  .home-slide.is-active .home-slide__right {
    animation: home-meta 1s 0.12s var(--ease) both;
  }

  @keyframes home-title {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
  }

  @keyframes home-meta {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .home-progress {
    position: fixed;
    bottom: clamp(1.25rem, 3vh, 2.15rem);
    left: 50%;
    z-index: 1002;
    display: flex;
    width: min(16rem, 44vw);
    flex-direction: column;
    gap: 0.55rem;
    color: #fff;
    mix-blend-mode: difference;
    transform: translateX(-50%);
  }

  .home-progress__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
  }

  .home-progress__count {
    font-variant-numeric: tabular-nums;
  }

  .home-progress__toggle {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    align-items: center;
    justify-content: center;
    font-size: 0.5rem;
    line-height: 1;
  }

  .pause-icon {
    display: flex;
    gap: 3px;
    align-items: center;
  }

  .pause-icon i {
    display: block;
    width: 1px;
    height: 7px;
    background: currentColor;
  }

  .play-icon {
    display: none;
    font-size: 0.42rem;
    transform: translateX(1px);
  }

  .home[data-paused='true'] .pause-icon {
    display: none;
  }

  .home[data-paused='true'] .play-icon {
    display: block;
  }

  .home-progress__bars {
    display: flex;
    gap: 0.32rem;
  }

  .home-progress__bar {
    position: relative;
    width: 100%;
    height: 0.85rem;
  }

  .home-progress__bar::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
  }

  .home-progress__bar span {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 1px;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .home-progress__bar.is-active span {
    animation: progress-fill var(--duration) linear forwards;
  }

  .home[data-paused='true'] .home-progress__bar.is-active span {
    animation-play-state: paused;
  }

  .home[data-reduced='true'] .home-progress__bar.is-active span {
    animation: none;
    transform: scaleX(1);
  }

  @keyframes progress-fill {
    to {
      transform: scaleX(1);
    }
  }

  .home-availability {
    position: fixed;
    right: var(--pad);
    bottom: clamp(1.4rem, 3.2vh, 2.2rem);
    z-index: 1001;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: #fff;
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1;
    text-align: right;
    text-transform: uppercase;
    mix-blend-mode: difference;
  }

  .home-availability__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--lilac);
    box-shadow: 0 0 0 3px rgba(197, 169, 205, 0.18);
  }

  @media (max-width: 900px) {
    .home-availability {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .home {
      min-height: 540px;
    }

    .home-slide__meta {
      top: 46%;
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .home-slide__left,
    .home-slide__right {
      flex-direction: row;
      justify-content: center;
      gap: 1rem;
      font-size: 0.5rem;
    }

    .home-slide__right {
      align-items: center;
    }

    .home-slide__number {
      display: none;
    }

    .home-slide__title {
      font-size: clamp(2.55rem, 13vw, 4.6rem);
    }

    .home-progress {
      right: auto;
      bottom: 1rem;
      left: var(--pad);
      width: 7.5rem;
      transform: none;
    }

    .home-progress__meta {
      display: none;
    }

    .home-progress__bars {
      gap: 0.22rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-slide__media video {
      transform: none;
      transition: none;
    }

    .home-progress__toggle {
      display: none;
    }
  }
</style>

<script>
  const home = document.querySelector<HTMLElement>('[data-home]');

  if (home) {
    const slides = Array.from(home.querySelectorAll<HTMLElement>('[data-slide]'));
    const bars = Array.from(home.querySelectorAll<HTMLButtonElement>('[data-progress]'));
    const counter = home.querySelector<HTMLElement>('[data-counter]');
    const toggle = home.querySelector<HTMLButtonElement>('[data-toggle]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const duration = 7000;

    let index = 0;
    let paused = reduceMotion;
    let timer: number | undefined;
    let wheelLockedUntil = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    home.dataset.reduced = String(reduceMotion);

    const activeVideo = () => slides[index]?.querySelector<HTMLVideoElement>('video');

    const restartBar = (bar: HTMLButtonElement | undefined) => {
      if (!bar) return;
      const fill = bar.querySelector<HTMLElement>('span');
      if (!fill) return;
      fill.style.animation = 'none';
      void fill.offsetWidth;
      fill.style.animation = '';
    };

    const setPaused = (next: boolean) => {
      paused = next;
      home.dataset.paused = String(paused);

      if (toggle) {
        toggle.setAttribute('aria-pressed', String(paused));
        toggle.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
      }

      if (paused) {
        window.clearTimeout(timer);
        activeVideo()?.pause();
      } else {
        activeVideo()?.play().catch(() => {});
        restartBar(bars[index]);
        schedule();
      }
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (paused || reduceMotion) return;
      timer = window.setTimeout(() => show(index + 1), duration);
    };

    const show = (nextIndex: number) => {
      index = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === index;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));

        if (isActive) {
          slide.removeAttribute('inert');
        } else {
          slide.setAttribute('inert', '');
        }

        const video = slide.querySelector<HTMLVideoElement>('video');

        if (video) {
          if (isActive && !paused && !reduceMotion) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      });

      bars.forEach((bar, barIndex) => {
        const isActive = barIndex === index;
        bar.classList.toggle('is-active', isActive);
        bar.setAttribute('aria-current', String(isActive));
      });

      restartBar(bars[index]);

      if (counter) {
        counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      }

      schedule();
    };

    // Progress controls
    bars.forEach((bar, barIndex) => {
      bar.addEventListener('click', () => show(barIndex));
    });

    toggle?.addEventListener('click', () => setPaused(!paused));

    // Keyboard
    window.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      show(index + (event.key === 'ArrowRight' ? 1 : -1));
    });

    // Wheel / trackpad. Prevent the page from feeling stuck: one slide per gesture.
    window.addEventListener(
      'wheel',
      (event) => {
        if (Math.abs(event.deltaY) < 18) return;
        const now = Date.now();
        if (now < wheelLockedUntil) return;
        wheelLockedUntil = now + 1100;
        show(index + (event.deltaY > 0 ? 1 : -1));
      },
      { passive: true },
    );

    // Touch swipe
    window.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = event.changedTouches[0].clientX;
        touchStartY = event.changedTouches[0].clientY;
      },
      { passive: true },
    );

    window.addEventListener(
      'touchend',
      (event) => {
        const dx = event.changedTouches[0].clientX - touchStartX;
        const dy = event.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) < 45 || Math.abs(dx) < Math.abs(dy)) return;
        show(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );

    // Pause when the tab is hidden; do not waste bandwidth.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        activeVideo()?.pause();
      } else if (!paused && !reduceMotion) {
        activeVideo()?.play().catch(() => {});
      }
    });

    if (!reduceMotion) {
      activeVideo()?.play().catch(() => {});
      schedule();
    }

    if (toggle && reduceMotion) {
      toggle.hidden = true;
    }
  }
</script>
